{
  "name": "@tickforge/sdk",
  "version": "0.1.0",
  "description": "Typed, resilient real-time market data client for crypto exchange WebSocket feeds. Works in Node and the browser.",
  "license": "MIT",
  "author": "Terence Faid JABO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faid-terence/tickforge.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/faid-terence/tickforge/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/faid-terence/tickforge/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "market-data",
    "websocket",
    "crypto",
    "coinbase",
    "binance",
    "trades",
    "candles",
    "ohlcv"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check:package": "publint --strict && attw --pack .",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "vitest": "^5.1.0",
    "ws": "^8.23.0"
  }
}
